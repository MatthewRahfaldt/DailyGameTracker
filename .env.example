# Copy this file to .env.local (for the Next.js app) and .env (for Prisma CLI commands),
# then fill in real values. Never commit .env or .env.local.

# Postgres connection string (Supabase / Neon / local Postgres all work)
DATABASE_URL="postgresql://user:password@localhost:5432/daily_game_tracker"

# Auth.js (NextAuth v5) — generate a secret with: npx auth secret
AUTH_SECRET="replace-me"

# GitHub OAuth App credentials (see docs/BACKLOG.md "Register GitHub OAuth App").
# Auth.js v5 picks these up automatically by this exact naming convention — no extra config needed.
AUTH_GITHUB_ID="replace-me"
AUTH_GITHUB_SECRET="replace-me"
