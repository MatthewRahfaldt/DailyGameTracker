// Daily Game Tracker — initial schema (Milestone 1).
// Groups/GroupGame are stubbed now so v2 (groups) doesn't need a breaking migration later,
// per docs/BACKLOG.md Section 7.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  /// Set once a user verifies via a magic-link email sign-in (Auth.js sets this automatically).
  emailVerified DateTime?
  name          String?
  image         String?
  timezone      String    @default("America/Chicago")
  createdAt     DateTime  @default(now())
  followCode String @unique @default(cuid())

  accounts     Account[]
  sessions     Session[]
  userGames    UserGame[]
  gameResults  GameResult[]
  groupMembers GroupMember[]

  following Follow[] @relation("follower")
  followers Follow[] @relation("following")
}

// --- Auth.js Prisma adapter tables ---
// Required once any provider needs durable storage: OAuth (Account) always did in principle, but
// specifically the email/magic-link provider (Resend, below) needs somewhere to store one-time
// verification tokens, which only a database adapter provides. Field names/shapes here follow
// Auth.js's standard Prisma adapter schema — see docs/BACKLOG.md's email sign-in issue.

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// One row per supported daily game (e.g. Wordle, Connections).
/// `parserKey` matches the key registered in packages/parsers.
model Game {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  parserKey String
  createdAt DateTime @default(now())

  userGames   UserGame[]
  gameResults GameResult[]
  groupGames  GroupGame[]
}

/// A game a user has assigned themselves to track.
model UserGame {
  userId String
  gameId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, gameId])
}

/// One parsed result for one user, one game, one day.
model GameResult {
  id          String   @id @default(cuid())
  userId      String
  gameId      String
  playedDate  DateTime @db.Date
  guesses     Int?
  won         Boolean?
  rawText     String
  parsedData  Json?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  // One result per user/game/day — re-pasting the same day's result should update, not duplicate.
  @@unique([userId, gameId, playedDate])
}

/// A one-way follow. `followerId` follows `followingId`.
/// Composite PK makes double-following impossible; the CHECK constraint added in the
/// migration SQL blocks self-follows (Prisma cannot express CHECK constraints).
model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
}

// --- v2 (groups) — stubbed now, built out in Milestone 5 ---

model Group {
  id         String   @id @default(cuid())
  name       String
  inviteCode String   @unique @default(cuid())
  createdAt  DateTime @default(now())

  members    GroupMember[]
  groupGames GroupGame[]
}

model GroupMember {
  groupId  String
  userId   String
  role     String @default("member") // "owner" | "admin" | "member"

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())

  @@id([groupId, userId])
}

/// A game assigned to a group — should propagate to each member's UserGame list (see backlog).
model GroupGame {
  groupId String
  gameId  String

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  game  Game  @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@id([groupId, gameId])
}
